<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.EasyExpenseControl" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Pantalla completa: sin barra de título, barra de estado y navegación transparentes -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_background_light</item>
    </style>
</resources>