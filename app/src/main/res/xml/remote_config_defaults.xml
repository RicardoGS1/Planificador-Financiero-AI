<?xml version="1.0" encoding="utf-8"?>
<!--
    Valores por defecto de Firebase Remote Config.
    Se usan cuando aún no se ha hecho fetch (p. ej. primer arranque sin red)
    o si el fetch falla.

    Claves disponibles:
      - app_open_ad_enabled: boolean. Si es false, AppOpenAdManager NO cargará ni
        mostrará anuncios App Open.
      - interstitial_ad_enabled: boolean. Si es false, no se precarga ni muestra el
        intersticial al entrar en presupuestos.
      - interstitial_ad_add_transaction_enabled: boolean. Si es false, no se muestra
        intersticial al guardar transacciones y volver atrás.
      - interstitial_ad_add_transaction_frequency: número entero >= 1. Cada cuántos
        guardados de transacción se muestra el intersticial (p. ej. 4 = 1 de cada 4).
      - interstitial_ad_frequency: número entero >= 1. Cada cuántas visitas a
        presupuestos se muestra el intersticial (p. ej. 4 = 1 de cada 4).
      - rewarded_ad_enabled: boolean. Si es false, CameraRewardedAdHelper NO
        precargará ni mostrará anuncios rewarded.
      - splash_app_open_max_wait_seconds: entero (3–60). Segundos máximos que el splash
        espera a que cargue el App Open antes de ir a la home (no cuenta mientras el
        anuncio está en pantalla). Por defecto 10.
      - min_version_code: entero >= 0. versionCode mínimo obligatorio. Si la app instalada
        es inferior, se fuerza actualización mediante Google Play. 0 = desactivado.
      Permite desactivar cada formato de forma remota (sin actualizar la app)
      ante problemas de inventario, política o UX.
-->
<defaultsMap>
    <entry>
        <key>app_open_ad_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>interstitial_ad_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>interstitial_ad_add_transaction_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>interstitial_ad_add_transaction_frequency</key>
        <value>1</value>
    </entry>
    <entry>
        <key>interstitial_ad_frequency</key>
        <value>1</value>
    </entry>
    <entry>
        <key>rewarded_ad_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>splash_app_open_max_wait_seconds</key>
        <value>10</value>
    </entry>
    <entry>
        <key>min_version_code</key>
        <value>0</value>
    </entry>
</defaultsMap>
